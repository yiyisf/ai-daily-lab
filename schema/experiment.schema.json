{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-daily-lab/schema/experiment.schema.json",
  "title": "AI Daily Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "goal", "runtime", "entry", "timeout_seconds", "related_item"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 4, "maxLength": 60 },
    "goal": { "type": "string", "minLength": 10, "maxLength": 300 },
    "related_item": { "type": "string" },
    "runtime": { "enum": ["python", "node", "shell"] },
    "entry": {
      "type": "string",
      "description": "在实验目录内执行的命令，如 python main.py",
      "minLength": 3
    },
    "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 300 },
    "expected": { "type": "string", "maxLength": 300, "description": "预期结果的一句话描述" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
