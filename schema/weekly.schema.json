{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-daily-lab/schema/weekly.schema.json",
  "title": "AI Weekly Report",
  "description": "每周周报：只做编辑判断（主线、必读、值得动手、下周关注），引用的都是当周日报里的条目；统计、软技能、Skill 精选、实验和标签热度由构建脚本自动生成。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "week",
    "generated_at",
    "title",
    "lede",
    "themes",
    "picks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$",
      "description": "ISO 周编号，如 2026-W43（周一到周日）"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 36,
      "description": "本周一句话：这一周最值得记住的变化"
    },
    "lede": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300,
      "description": "导语，2–4 句，串起本周的主线"
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "本周主线：把几天里相关的条目串成一条线",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "item_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 30
          },
          "summary": {
            "type": "string",
            "minLength": 30,
            "maxLength": 240,
            "description": "这条线发生了什么、各条目之间什么关系"
          },
          "item_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "picks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "本周必读",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "reason"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 60,
            "description": "为什么值得读，一句话"
          }
        }
      }
    },
    "hands_on": {
      "type": "array",
      "maxItems": 4,
      "description": "本周值得动手：actionability 为 try 的条目",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "reason"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 60,
            "description": "适合谁、动手做什么"
          }
        }
      }
    },
    "watch_next": {
      "type": "array",
      "maxItems": 3,
      "description": "下周关注：只写原文已公布的后续计划或待定事项",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "item_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80
          },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "editor_note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200,
      "description": "可选：本周有缺期、内容偏少等情况时说明"
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "每周小测：3–5 道单选题，每题出自本周一个条目，答案必须是该条目原文写明的事实",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "options",
          "answer",
          "explanation",
          "item_id"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "description": "题干，一句话"
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "正确选项的下标，从 0 开始"
          },
          "explanation": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120,
            "description": "为什么是这个答案，引用条目里的事实"
          },
          "item_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
