{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-daily-lab/schema/daily.schema.json",
  "title": "AI Daily Issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "generated_at", "editor_note", "items", "experiments"],
  "properties": {
    "schema_version": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "editor_note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "今日导读：2-4 句，概括当天最值得关注的内容"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/item" }
    },
    "experiments": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "summary", "key_points", "why_it_matters", "sources", "tags", "importance"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$" },
        "category": { "enum": ["news", "opensource", "tools", "ideas", "practices", "research"] },
        "title": { "type": "string", "minLength": 4, "maxLength": 60 },
        "summary": { "type": "string", "minLength": 20, "maxLength": 500 },
        "key_points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 4, "maxLength": 160 }
        },
        "why_it_matters": { "type": "string", "minLength": 10, "maxLength": 300 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "kind"],
            "properties": {
              "title": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "pattern": "^https?://" },
              "kind": { "enum": ["primary", "secondary", "discussion"] },
              "publisher": { "type": "string" },
              "published_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "follow_up_of": { "type": "string" },
        "experiment_id": { "type": "string" },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "description": "opensource 类可选：仓库信息",
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "license": { "type": "string" },
            "language": { "type": "string" }
          }
        }
      }
    }
  }
}
