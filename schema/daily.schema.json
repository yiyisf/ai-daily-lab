{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-daily-lab/schema/daily.schema.json",
  "title": "AI Daily Issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "generated_at",
    "editor_note",
    "items",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "editor_note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "今日导读：2-4 句，概括当天最值得关注的内容"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$"
      }
    },
    "tldr": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "今日三件事：每句对应一个条目，30 秒看懂今天",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "item_id"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 60
          },
          "item_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "hands_on": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "今天可以试：从 actionability 为 try 的条目中挑 1–3 条，写清楚为什么值得试、怎么动手",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "reason",
          "steps"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "description": "一句话：对读者有什么用、解决什么问题"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 4,
              "maxLength": 100
            },
            "description": "动手验证的步骤，最多 3 步，每步一句，读者照着做就能验证"
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "summary",
        "key_points",
        "why_it_matters",
        "sources",
        "tags",
        "importance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$"
        },
        "category": {
          "enum": [
            "news",
            "opensource",
            "tools",
            "kits",
            "ideas",
            "practices",
            "skills",
            "research"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "key_points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 160
          }
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url",
              "kind"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 2
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "kind": {
                "enum": [
                  "primary",
                  "secondary",
                  "discussion"
                ]
              },
              "publisher": {
                "type": "string"
              },
              "published_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "follow_up_of": {
          "type": "string"
        },
        "experiment_id": {
          "type": "string"
        },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "description": "opensource 类可选：仓库信息",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "license": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        },
        "actionability": {
          "enum": [
            "try",
            "watch",
            "know"
          ],
          "description": "try=可动手（读者今天就能安装或试用），watch=值得关注，know=了解即可"
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "description": "AI 软技能条目专用：一个场景下「较差 vs 更好」的对比示例",
          "required": [
            "area",
            "scenario",
            "bad",
            "good",
            "why"
          ],
          "properties": {
            "area": {
              "enum": [
                "goal",
                "context",
                "decompose",
                "review",
                "iterate",
                "delegate",
                "judgment"
              ],
              "description": "goal=目标表达 context=上下文供给 decompose=任务拆解 review=审查验证 iterate=反馈迭代 delegate=委派与边界 judgment=判断与取舍"
            },
            "scenario": {
              "type": "string",
              "minLength": 8,
              "maxLength": 120,
              "description": "具体工作场景"
            },
            "bad": {
              "type": "string",
              "minLength": 4,
              "maxLength": 600,
              "description": "较差的做法/描述（示例）"
            },
            "good": {
              "type": "string",
              "minLength": 10,
              "maxLength": 1200,
              "description": "更好的做法/描述（示例）"
            },
            "why": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 120
              },
              "description": "好在哪里，每条一句"
            },
            "practice": {
              "type": "string",
              "maxLength": 160,
              "description": "可选：一个今天就能做的小练习"
            }
          }
        },
        "kit": {
          "type": "object",
          "additionalProperties": false,
          "description": "Skill 精选条目专用：一个 Agent Skill / MCP 服务 / 插件的能力、亮点、安装方式和版本更新",
          "required": [
            "kind",
            "name",
            "capabilities",
            "highlights",
            "install"
          ],
          "properties": {
            "kind": {
              "enum": [
                "skill",
                "mcp",
                "plugin",
                "subagent",
                "hook",
                "other"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "version": {
              "type": "string",
              "maxLength": 40
            },
            "compatible": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "description": "适用的 Agent / 客户端"
            },
            "capabilities": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 120
              },
              "description": "能做什么"
            },
            "highlights": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 140
              },
              "description": "好在哪里（设计上的亮点）"
            },
            "install": {
              "type": "string",
              "minLength": 4,
              "maxLength": 400,
              "description": "安装或启用方式，必须来自原文"
            },
            "changes": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 140
              },
              "description": "本次版本更新内容"
            },
            "license": {
              "type": "string",
              "maxLength": 40
            },
            "repo": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "figure": {
          "type": "object",
          "additionalProperties": false,
          "description": "可选的结构图：steps=流程/结构（2–5 步，可带循环和底座），bars=前后或多项对比的数字。每期最多 3 张，只画原文支持的内容",
          "required": [
            "type",
            "title"
          ],
          "properties": {
            "type": {
              "enum": [
                "steps",
                "bars"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "这张图要说明的结论，一句话"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "图注：数据或结构出自哪里"
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18,
                    "description": "步骤名，可用英文原名"
                  },
                  "sub": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 28,
                    "description": "一句中文说明"
                  }
                }
              }
            },
            "loop": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "从最后一步回到第一步的循环说明，如「不满意就再迭代一轮」"
            },
            "base": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "description": "各步共同沉淀或依赖的底座"
                },
                "sub": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "description": "bars 的数据系列名，如 [\"旧版\", \"新版\"]"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "values"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 28
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "unit": {
              "type": "string",
              "maxLength": 12,
              "description": "数值单位，如 分、%、tokens/s"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "steps"
                  }
                }
              },
              "then": {
                "required": [
                  "steps"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "bars"
                  }
                }
              },
              "then": {
                "required": [
                  "series",
                  "rows"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
